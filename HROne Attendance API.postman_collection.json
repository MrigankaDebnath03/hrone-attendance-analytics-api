            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('race ran against readiness endpoint', function () { pm.response.to.have.status(200); });", "pm.test('atomic close permits exactly one success', function () { pm.expect(JSON.parse(pm.collectionVariables.get('raceOutStatuses') || '[]')).to.eql([200,409]); });"] } }
          ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } }
        },
        {
          "name": "Create regularization race record",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('regularization race record created', function () { pm.response.to.have.status(201); });"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"emp_code\":\"{{emp_racePatch}}\",\"punched_at\":{{ts_racePatchIn}}}" }, "url": { "raw": "{{baseUrl}}/attendance/punch-in", "host": ["{{baseUrl}}"], "path": ["attendance", "punch-in"] } }
        },
        {
          "name": "Race two regularizations (one 200, one 409)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["const base = pm.collectionVariables.get('baseUrl');", "const emp = pm.collectionVariables.get('emp_racePatch');", "const url = base+'/attendance/'+emp+'/2026-08-21';", "const make = status => pm.sendRequest({url,method:'PATCH',header:{'Content-Type':'application/json'},body:{mode:'raw',raw:JSON.stringify({status,reason:'Parallel correction',regularized_by:'Postman QA'})}});", "const responses = await Promise.all([make('WFH'), make('ON_DUTY')]);", "pm.collectionVariables.set('racePatchStatuses', JSON.stringify(responses.map(response => response.code).sort((a,b) => a-b)));" ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('race ran against readiness endpoint', function () { pm.response.to.have.status(200); });", "pm.test('optimistic history guard prevents lost correction', function () { pm.expect(JSON.parse(pm.collectionVariables.get('racePatchStatuses') || '[]')).to.eql([200,409]); });"] } }
          ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } }
        }
      ]
    }
  ]
}
